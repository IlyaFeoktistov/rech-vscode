{
  "name": "rech",
  "displayName": "Rech",
  "description": "Подсветка синтаксиса и команды сборки/запуска для языка Rech",
  "version": "0.1.0",
  "publisher": "ilyafeoktistov",
  "author": "Ilya Feoktistov",
  "license": "SEE LICENSE IN https://github.com/IlyaFeoktistov/Rech",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaFeoktistov/rech-vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:rech"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rech",
        "aliases": ["Rech", "rech"],
        "extensions": [".rech"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "yaml",
        "extensions": [".rechproj"]
      }
    ],
    "grammars": [
      {
        "language": "rech",
        "scopeName": "source.rech",
        "path": "./syntaxes/rech.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rech.build",
        "title": "Rech: собрать",
        "icon": "$(gear)"
      },
      {
        "command": "rech.buildLib",
        "title": "Rech: собрать библиотеку"
      },
      {
        "command": "rech.run",
        "title": "Rech: собрать и запустить",
        "icon": "$(play)"
      },
      {
        "command": "rech.test",
        "title": "Rech: запустить тесты"
      },
      {
        "command": "rech.debug",
        "title": "Rech: отладить",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rech.run",
          "when": "resourceLangId == rech",
          "group": "navigation@1"
        },
        {
          "command": "rech.debug",
          "when": "resourceLangId == rech",
          "group": "navigation@2"
        },
        {
          "command": "rech.build",
          "when": "resourceLangId == rech",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        { "command": "rech.build", "when": "resourceLangId == rech" },
        { "command": "rech.buildLib", "when": "resourceLangId == rech" },
        { "command": "rech.run", "when": "resourceLangId == rech" },
        { "command": "rech.debug", "when": "resourceLangId == rech" },
        { "command": "rech.test" }
      ]
    },
    "breakpoints": [
      { "language": "rech" }
    ],
    "debuggers": [
      {
        "type": "rech",
        "label": "Rech",
        "languages": ["rech"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Файл или каталог .rech (либо файл .rechproj) для отладки. По умолчанию - файл проекта (.rechproj) в корне рабочей области, если он единственный, иначе активный .rech-файл редактора.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Остановиться на самой первой исполненной инструкции \"главная\".",
                "default": false
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Rech: отладить",
            "description": "Запуск отладчика Rech (rech debug) - без \"program\" использует файл проекта/активный файл.",
            "body": {
              "type": "rech",
              "request": "launch",
              "name": "Rech: отладить",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Rech",
      "properties": {
        "rech.path": {
          "type": "string",
          "default": "rech",
          "description": "Путь к исполняемому файлу компилятора rech (по умолчанию ищется в PATH)."
        },
        "rech.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Форматирование документа (\"rech fmt\") - канонический отступ. Работает и по команде \"Format Document\", и автоматически при сохранении, если включена штатная настройка VS Code \"editor.formatOnSave\" (не своя - её включает сам редактор, не это расширение)."
        },
        "rech.format.maxLineLength": {
          "type": "number",
          "default": 120,
          "description": "Максимальная длина строки для автопереноса. ЗАРЕЗЕРВИРОВАНО НА БУДУЩЕЕ: сам компилятор (\"rech fmt\") пока умеет только канонический отступ, перенос длинных строк не реализован (docs/ROADMAP.md проекта Rech, Шаг 89) - эта настройка пока ни на что не влияет."
        }
      }
    }
  },
  "scripts": {
    "lint": "node --check extension.js"
  }
}
