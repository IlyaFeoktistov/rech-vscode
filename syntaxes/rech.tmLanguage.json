{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rech",
  "scopeName": "source.rech",
  "fileTypes": ["rech"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#this-keyword" },
    { "include": "#keywords-control" },
    { "include": "#json-format-marker" },
    { "include": "#logical-word-operators" },
    { "include": "#visibility-keywords" },
    { "include": "#export-keyword" },
    { "include": "#constructor-keywords" },
    { "include": "#function-declaration" },
    { "include": "#entity-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#constant-declaration" },
    { "include": "#keywords-declaration" },
    { "include": "#prepositions" },
    { "include": "#builtin-types" },
    { "include": "#operators" },
    { "include": "#method-call" },
    { "include": "#field-access" },
    { "include": "#function-call" },
    { "include": "#type-name" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "'/** ... */' (doc-комментарий, docs/SPEC.md) - ДО обычного блочного, иначе тот перехватил бы его с первых двух символов. '(?!/)' исключает '/**/'  (закрывается немедленно) - это обычный пустой блочный комментарий, не doc.",
          "name": "comment.block.documentation.rech",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [
            { "match": "^\\s*\\*(?!/)", "name": "punctuation.definition.comment.rech" }
          ]
        },
        {
          "name": "comment.block.rech",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.rech",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rech",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rech",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rech",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.rech",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.rech",
      "match": "\\b(истина|ложь)\\b"
    },
    "this-keyword": {
      "name": "variable.language.this.rech",
      "match": "\\bэтот\\b"
    },
    "keywords-control": {
      "name": "keyword.control.rech",
      "match": "\\b(если|иначе|пока|для|от|до|вернуть|утверждать|становится|попытаться|поймать|выбросить|относится|запустить|дождаться|разобрать|сериализовать)\\b"
    },
    "json-format-marker": {
      "comment": "'JSON' - формат-маркер после 'разобрать' (разобрать JSON <выражение> как <Тип>) - не склоняется, единственный поддержанный формат.",
      "name": "support.type.rech",
      "match": "\\bJSON\\b"
    },
    "logical-word-operators": {
      "name": "keyword.operator.word.rech",
      "match": "\\b(и|или|не)\\b"
    },
    "visibility-keywords": {
      "name": "storage.modifier.rech",
      "match": "\\b(приватный|приватная|приватное|приватные|публичный|публичная|публичное|публичные)\\b"
    },
    "export-keyword": {
      "comment": "'экспортировать' перед 'функция'/'сущность'/'класс'/'структура' - помечает объявление видимым снаружи разделяемой библиотеки (rech build --lib). Тот же scope, что и visibility-keywords выше - оба модификатор перед объявлением, различие смысла компилятору, не подсветке.",
      "name": "storage.modifier.rech",
      "match": "\\bэкспортировать\\b"
    },
    "constructor-keywords": {
      "name": "keyword.other.new.rech",
      "match": "\\b(новый|новая|новое|новые)\\b"
    },
    "function-declaration": {
      "match": "\\b(функция)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.rech" },
        "2": { "name": "entity.name.function.rech" }
      }
    },
    "entity-declaration": {
      "comment": "'сущность'/'класс' - ссылочная семантика; 'структура' - по значению (шаг 12) - та же форма объявления, тот же scope имени типа, разница в семантике значения, не в подсветке.",
      "match": "\\b(сущность|класс|структура)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.rech" },
        "2": { "name": "entity.name.type.rech" }
      }
    },
    "enum-declaration": {
      "match": "\\b(перечисление)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.rech" },
        "2": { "name": "entity.name.type.rech" }
      }
    },
    "constant-declaration": {
      "comment": "'константа ИМЯ' (в том числе после 'приватная'/'публичная' - те распознаются отдельным правилом раньше в списке). Имя константы - отдельная область 'variable.other.constant', а не 'entity.name.type', даже когда оно записано ЗАГЛАВНЫМИ_БУКВАМИ_С_ПОДЧЁРКИВАНИЕМ и иначе совпало бы с правилом для имён типов/сущностей.",
      "match": "\\b(константа)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.rech" },
        "2": { "name": "variable.other.constant.rech" }
      }
    },
    "keywords-declaration": {
      "name": "keyword.other.rech",
      "match": "\\b(функция|переменная|сущность|класс|структура|имеет|использовать|из|как|внешняя|состояние|вывести|показать|константа|перечисление)\\b"
    },
    "prepositions": {
      "name": "keyword.other.preposition.rech",
      "match": "\\b(с|в|к)\\b"
    },
    "builtin-types": {
      "name": "support.type.primitive.rech",
      "match": "\\b(Строка|Целое|Число|Логическое|Файл|Список|Стопка|Очередь|Словарь|ОшибкаРазбора)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.rech",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.rech",
          "match": "<<|>>|\\||\\^|&|~"
        },
        {
          "name": "keyword.operator.arithmetic.rech",
          "match": "\\+\\+|--|\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.assignment.rech",
          "match": "="
        }
      ]
    },
    "method-call": {
      "match": "\\.([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.rech" }
      }
    },
    "field-access": {
      "comment": "'.имя' - поле/метод, но '.КОНСТАНТА_СУЩНОСТИ' (ЗАГЛАВНЫМИ, соглашение для 'константа' внутри сущности) - отдельная область 'variable.other.constant', не обычный член.",
      "match": "\\.([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
      "captures": {
        "1": {
          "patterns": [
            { "match": "^[A-ZА-ЯЁ][A-ZА-ЯЁ0-9_]*$", "name": "variable.other.constant.rech" },
            { "match": ".*", "name": "variable.other.member.rech" }
          ]
        }
      }
    },
    "function-call": {
      "comment": "Голый идентификатор перед '(' - вызов функции (обычный, внешний по alias-имени после 'как', или объявление функции/метода - те же 'имя(' по форме). Только с маленькой буквы - имена типов/сущностей (Пользователь(...) в конструкторе 'новый Пользователь(...)') с большой и остаются entity.name.type через отдельное правило ниже.",
      "match": "\\b[a-zа-яё_][A-Za-zА-Яа-яЁё0-9_]*(?=\\s*\\()",
      "name": "entity.name.function.rech"
    },
    "type-name": {
      "name": "entity.name.type.rech",
      "match": "\\b[A-ZА-ЯЁ][A-Za-zА-Яа-яЁё0-9_]*\\b"
    }
  }
}
