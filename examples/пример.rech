// Пример для визуальной проверки подсветки - собран из реальных примеров
// репозитория github.com/IlyaFeoktistov/Rech (examples/).

константа МАКСИМАЛЬНЫЙ_ВОЗРАСТ_ОТДЕЛЬНОЙ_КОНСТАНТЫ = 200

перечисление Роль
{
    Гость,
    Участник,
    Администратор = 10
}

структура Точка
{
    имеет:
        x: Целое
        y: Целое
}

сущность Пользователь
{
    константа МАКСИМАЛЬНЫЙ_ВОЗРАСТ = 150

    состояние: авторизован

    имеет:
        статический счёт_созданных: Целое = 0
        приватный пароль: Строка
        имя: Строка
        возраст: ?Целое

    конструктор(пароль: Строка, имя: Строка)
    {
        этот.пароль = пароль
        этот.имя = имя
        Пользователь::счёт_созданных = Пользователь::счёт_созданных + 1
    }

    приватный проверить_пароль(попытка: Строка): Логическое
    {
        вернуть этот.пароль == попытка
    }

    публичный войти(попытка: Строка): Логическое
    {
        вернуть этот.проверить_пароль(попытка)
    }

    авторизовать()
    {
        этот становится авторизованным
    }
}

функция поприветствовать(кого: Строка, где: Строка)
{
    вывести "Привет, " + кого + "! Добро пожаловать в " + где
}

функция главная
{
    переменная аня = новый Пользователь(пароль: "секрет", имя: "Аня")
    переменная числа = новый Список<Целое>()

    если аня.войти("секрет")
    {
        вывести "вход разрешён"
    }
    иначе
    {
        вывести "отказано"
    }

    для i от 1 до 5
    {
        числа.добавить(i * i)
    }

    для x в числах
    {
        вывести x
    }

    переменная пользователь = "Илья"
    переменная система = "чат"
    поприветствовать пользователя в системе

    вывести Пользователь::МАКСИМАЛЬНЫЙ_ВОЗРАСТ
    вывести Пользователь::счёт_созданных
    вывести МАКСИМАЛЬНЫЙ_ВОЗРАСТ_ОТДЕЛЬНОЙ_КОНСТАНТЫ
    вывести Роль.Администратор

    переменная точка = новая Точка(1, 2)

    переменная остаток = 17 % 5
    вывести остаток

    переменная возраст = аня.возраст ?? -1
    вывести возраст

    переменная опытВозраст = аня.возраст
    опытВозраст ?= 30
    вывести опытВозраст ?? -1

    попытаться
    {
        переменная х = числа.получить(99)
    }
    поймать(сообщение: Паника)
    {
        вывести "паника: " + сообщение
    }
}
