/** Обратное к разбору: "сериализовать JSON <выражение>" -> Строка.
    Адрес/Пользователь - НАМЕРЕННО без явного "конструктор(...)": "разобрать
    JSON ... как Пользователь" ниже заполняет поля напрямую (рефлексией), а
    не через конструктор - у сущности с собственным конструктором так
    нельзя (docs/SPEC.md, раздел 18). */
сущность Адрес
{
    имеет:
        город: Строка
}

сущность Пользователь
{
    имеет:
        имя: Строка
        возраст: Целое
        адрес: Адрес
}

функция главная
{
    переменная адрес = новый Адрес()
    адрес.город = "Москва"

    переменная пользователь = новый Пользователь()
    пользователь.имя = "Аня"
    пользователь.возраст = 30
    пользователь.адрес = адрес
    вывести сериализовать JSON пользователь

    переменная числа = новый Список<Целое>()
    числа.добавить(1)
    числа.добавить(2)
    числа.добавить(3)
    вывести сериализовать JSON числа

    вывести сериализовать JSON "текст со \"скобками\""

    переменная восстановленный = разобрать JSON (сериализовать JSON пользователь) как Пользователь
    вывести восстановленный.имя
    вывести восстановленный.адрес.город
}
