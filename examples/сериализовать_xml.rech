/** Обратное к разбору: "сериализовать XML <выражение>" -> Строка. */
сущность Адрес
{
    имеет:
        город: Строка
}

сущность Пользователь
{
    имеет:
        имя: Строка
        возраст: Целое
        адрес: Адрес
}

функция главная
{
    переменная адрес = новый Адрес("Москва")
    переменная пользователь = новый Пользователь("Аня", 30, адрес)
    вывести сериализовать XML пользователь

    переменная числа = новый Список<Целое>()
    числа.добавить(1)
    числа.добавить(2)
    числа.добавить(3)
    вывести сериализовать XML числа

    вывести сериализовать XML "текст с <тегами> и амперсандом &"

    переменная восстановленный = разобрать XML (сериализовать XML пользователь) как Пользователь
    вывести восстановленный.имя
    вывести восстановленный.адрес.город
}
